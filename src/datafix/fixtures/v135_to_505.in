# EntityRidingToPassengersFix (v135) also normalises the whole player
CHUNK|99|135|{Level:{Entities:[{id:"Zombie",Riding:{id:"Pig"}}]}}
CHUNK|99|135|{Level:{Entities:[{id:"Zombie",CustomName:"Bob",Riding:{id:"Pig",CustomName:"Oink"}}]}}
PLAYER|99|135|{Inventory:[{id:5s,Count:1b,Damage:0s}],EnderItems:[],Dimension:0}
ENTITY_CHUNK|99|135|{Entities:[{id:"Zombie",Riding:{id:"Pig"}}]}
# unknown entity ids make the whole entity list opaque
CHUNK|99|135|{Level:{Entities:[{id:"Zombie",Riding:{id:"Pig"}},{id:"NotARealMob",Riding:{id:"Pig"}}]}}
