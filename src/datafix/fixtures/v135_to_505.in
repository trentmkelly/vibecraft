CHUNK|99|165|{Level:{TileEntities:[{id:"Sign",Text1:"{broken",Text2:"[1,,2]",Text3:"{a=1;b=>2}",Text4:"\"esc\\u00e9\\n\""}]}}
CHUNK|99|165|{Level:{TileEntities:[{id:"Sign",Text1:"{\"b\":1,\"a\":2}",Text2:"\"\"",Text3:"[]",Text4:"{}"}]}}
PLAYER|99|165|{Inventory:[{id:387s,Count:1b,Damage:0s,tag:{pages:["Page one","{\"text\":\"two\"}","\"three\"",""],title:"T",author:"A"}},{id:386s,Count:1b,Damage:0s,tag:{pages:["not touched"]}}]}
